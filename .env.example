# Unified Diptera Configuration Example
APP_PORT=8787
HOST=0.0.0.0
PORT=8787
DATA_DIR=/app/data
DEFAULT_WORKSPACE=asoc
DIPTERA_PUBLIC_URL=http://<diptera-host>:8787

# Workspace ASOC (Alpha Reporter v2)
ASOC_N8N_BASE_URL=http://<n8n-asoc-host>:5678
ASOC_FORM_PATH=alpha-form
ASOC_IRIS_BASE_URL=https://<dfir-iris-host>
ASOC_CASE_ID_MODE=auto_iris

# Workspace SOC (Charlie Reporter)
SOC_N8N_BASE_URL=http://<n8n-soc-host>:5678
SOC_FORM_PATH=Job-Creator

# Approval Center (Opsional)
# Gunakan APPROVAL_API_SECRET_HASH agar secret tidak tersimpan plaintext di .env
# Generate hash via: npm run hash-credential -- hash-secret <secret-anda>
# APPROVAL_API_SECRET=
# APPROVAL_API_SECRET_HASH=
# APPROVAL_ALLOWED_HOSTS=
# APPROVAL_REWRITE_RESUME_HOST=false

# PostgreSQL Persistence
POSTGRES_DB=diptera
POSTGRES_USER=diptera
POSTGRES_PASSWORD=diptera_secret_change_me
# DATABASE_URL=postgres://diptera:diptera_secret_change_me@postgres:5432/diptera
# PGHOST=postgres
# PGPORT=5432
# PGSSL=false

# Autentikasi & Manajemen User
# Disarankan memakai ADMIN_PASSWORD_HASH (scrypt) daripada ADMIN_PASSWORD plaintext
# Generate hash via: npm run hash-credential -- hash <password-anda>
AUTH_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# ADMIN_PASSWORD_HASH=scrypt$...
ADMIN_DISPLAY_NAME=Administrator
SESSION_TTL_HOURS=168
COOKIE_SECURE=false
