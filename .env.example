# Diptera Environment Variables
# Salin file ini menjadi .env, lalu sesuaikan isinya:
#   cp .env.example .env
#
# server.js memuat .env secara otomatis saat `npm start`.
# .env sudah di .gitignore, jadi aman tidak ikut ter-commit.

# Alamat n8n (browser harus bisa mengakses ini langsung).
# Kalau kosong, aplikasi menebak dari alamat halaman (localhost -> localhost:5678).
N8N_BASE_URL=http://localhost:5678

# Path node "Alert Intake Form" di workflow n8n.
# Ganti dengan nama form workflow kamu (contoh: nama-form-workflow).
DIPTERA_FORM_PATH=nama-form-workflow

# Daftar tenant untuk dropdown "Tenant / Organisasi" (JSON array).
# WAJIB diisi kalau mau tenant muncul; daftar tidak lagi ditanam di kode.
# Contoh: ["tenant-a","tenant-b","tenant-c"]
TENANT_OPTIONS=["tenant-a","tenant-b"]

# --- Opsional: penomoran awal (nomor tiket & case ID) ---

# Nomor tiket awal per tenant (JSON object: tenant -> nomor).
# INITIAL_TICKETS={"tenant-a":"10000","tenant-b":"20000"}

# Case ID global awal (contoh #1001).
# INITIAL_CASE_ID=#1001

# Alternatif INITIAL_TICKETS: tenant + tiket awal sekaligus dalam satu map.
# INITIAL_TENANTS={"tenant-a":"10000","tenant-b":"20000"}
