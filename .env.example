# Unified Diptera Configuration Example
APP_PORT=8787
HOST=0.0.0.0
PORT=8787
DATA_DIR=/app/data
DEFAULT_WORKSPACE=asoc
DIPTERA_PUBLIC_URL=http://<diptera-host>:8787

# Workspace ASOC (Alpha Reporter v2)
ASOC_N8N_BASE_URL=http://<n8n-asoc-host>:5678
ASOC_FORM_PATH=alpha-form
ASOC_IRIS_BASE_URL=https://<dfir-iris-host>
ASOC_CASE_ID_MODE=auto_iris

# Workspace SOC (Charlie Reporter)
SOC_N8N_BASE_URL=http://<n8n-soc-host>:5678
SOC_FORM_PATH=Job-Creator
